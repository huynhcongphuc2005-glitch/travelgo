# Sao chép file này thành .env rồi chỉnh sửa giá trị phù hợp:
#   cp .env.example .env

NODE_ENV=development
PORT=3000

# BẮT BUỘC đổi thành chuỗi ngẫu nhiên dài khi triển khai thật
JWT_SECRET=doi-chuoi-bi-mat-nay-truoc-khi-deploy
JWT_EXPIRES_IN=7d

# Đường dẫn file lưu dữ liệu người dùng & đơn đặt (mặc định: ./data/db.json)
# DB_FILE=./data/db.json

# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy). Để trống = cho phép tất cả.
# CORS_ORIGINS=http://localhost:3000
